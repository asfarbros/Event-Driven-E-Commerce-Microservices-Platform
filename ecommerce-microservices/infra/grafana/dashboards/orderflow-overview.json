{
 "uid": "orderflow-overview",
 "title": "OrderFlow \u2014 Overview",
 "tags": [
  "orderflow"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Request rate (req/s) per service",
   "description": "All seven services expose the same histogram name/labels (Spring Boot's), so one query covers Node and Java.",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{application}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Error rate (5xx share) per service",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     },
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) / sum by (application) (rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{application}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Latency p95 per service",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[2m])))",
     "legendFormat": "{{application}} p95"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Latency p50 per service",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le, application) (rate(http_server_requests_seconds_bucket[2m])))",
     "legendFormat": "{{application}} p50"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Kafka consumer lag (records) by service & topic",
   "description": "Micrometer's Kafka client metrics from each consuming service (Order, Inventory, Payment). Lag that stays > 0 = a consumer is blocked or stopped.",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (application, topic) (kafka_consumer_fetch_manager_records_lag_max)",
     "legendFormat": "{{application}} \u2190 {{topic}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "RabbitMQ queue depth (ready messages)",
   "description": "From RabbitMQ's prometheus plugin (/metrics/detailed). Retry tiers fill during backoff; the DLQ should stay at 0.",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rabbitmq_detailed_queue_messages_ready",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Notification worker outcomes",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "notification_messages_total",
     "legendFormat": "{{outcome}} ({{instance_id}})"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Circuit breakers (1 = open)",
   "description": "Resilience4j per-dependency breakers in Order and Payment. Open = the dependency is being skipped (fail fast).",
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     },
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (application, name) (resilience4j_circuitbreaker_state{state=\"open\"})",
     "legendFormat": "{{application}}/{{name}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "JVM heap / Node RSS",
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "{{application}} heap"
    },
    {
     "refId": "B",
     "expr": "process_resident_memory_bytes{application=~\"api-gateway|catalog|cart|notification\"}",
     "legendFormat": "{{application}} rss"
    }
   ]
  },
  {
   "id": 10,
   "type": "stat",
   "title": "Targets up",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up)",
     "legendFormat": "targets up"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Orders confirmed / cancelled / failed (rate)",
   "description": "Optional: only populated if the Order Service exports order_transitions_total; otherwise stays empty.",
   "gridPos": {
    "x": 4,
    "y": 32,
    "w": 20,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(order_transitions_total[5m]))",
     "legendFormat": "{{status}}"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 }
}
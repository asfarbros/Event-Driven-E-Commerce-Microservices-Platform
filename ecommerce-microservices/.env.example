# =============================================================================
# OrderFlow — environment template
# =============================================================================
# Copy to .env and fill in the values:   cp .env.example .env
#
# * .env is gitignored; .env.example is committed. Never put real secrets here.
# * EVERY configurable value in the system lives in .env — nothing is hardcoded.
#   The same code runs locally or on a server by swapping these values only.
# * Docker Compose reads this file with:  docker compose --env-file .env ...
# * Avoid these characters in passwords: @ : / # $ (they break URLs and
#   Compose interpolation). Letters, digits, _ and - are always safe.
# * host:port values below are for services running ON THE HOST. When a service
#   is containerised later, swap "localhost" for the container name
#   (postgres, mongodb, redis, kafka, rabbitmq) and Kafka to kafka:29092.
# =============================================================================


# -----------------------------------------------------------------------------
# Infrastructure (general)
# -----------------------------------------------------------------------------
# Node runtime mode for the Node services (development | production)
NODE_ENV=development
# Log verbosity for all services (debug | info | warn | error)
LOG_LEVEL=debug
# Timezone applied to containers and logs
TZ=UTC
# Spring profile for the Java services (local | docker | prod)
SPRING_PROFILES_ACTIVE=local
# Docker network name shared by every container (app containers join it later)
DOCKER_NETWORK=orderflow-net


# -----------------------------------------------------------------------------
# PostgreSQL (one container, THREE isolated databases — Order / Inventory / Payment)
# -----------------------------------------------------------------------------
# Host port the Postgres container is published on
POSTGRES_PORT=5432
# Superuser — used ONLY by the init script to create the three databases
POSTGRES_SUPERUSER=postgres
# Superuser password — never used by any application service
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser

# --- Order Service database ---
# Database name owned by the Order Service
ORDER_DB_NAME=order_db
# Dedicated login role for the Order Service (owner of order_db)
ORDER_DB_USER=order_user
# Password for ORDER_DB_USER
ORDER_DB_PASSWORD=change_me_order
# JDBC URL the Order Service connects with (host:port must match POSTGRES_PORT)
ORDER_DB_URL=jdbc:postgresql://localhost:5432/order_db

# --- Inventory Service database ---
# Database name owned by the Inventory Service
INVENTORY_DB_NAME=inventory_db
# Dedicated login role for the Inventory Service (owner of inventory_db)
INVENTORY_DB_USER=inventory_user
# Password for INVENTORY_DB_USER
INVENTORY_DB_PASSWORD=change_me_inventory
# JDBC URL the Inventory Service connects with
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventory_db

# --- Payment Service database ---
# Database name owned by the Payment Service
PAYMENT_DB_NAME=payment_db
# Dedicated login role for the Payment Service (owner of payment_db)
PAYMENT_DB_USER=payment_user
# Password for PAYMENT_DB_USER
PAYMENT_DB_PASSWORD=change_me_payment
# JDBC URL the Payment Service connects with
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db


# -----------------------------------------------------------------------------
# MongoDB (one container; catalog_db and cart_db are created by the apps on first write)
# -----------------------------------------------------------------------------
# Host port the MongoDB container is published on (change if a local mongod already uses 27017)
MONGO_PORT=27017
# Root user created on first start (lives in the admin database)
MONGO_ROOT_USER=root
# Root password
MONGO_ROOT_PASSWORD=change_me_mongo
# Database name owned by the Catalog Service (NOT pre-created)
CATALOG_DB_NAME=catalog_db
# Database name owned by the Cart Service (NOT pre-created)
CART_DB_NAME=cart_db
# Full connection string for the Catalog Service (points at catalog_db only)
CATALOG_MONGO_URI=mongodb://root:change_me_mongo@localhost:27017/catalog_db?authSource=admin
# Full connection string for the Cart Service (points at cart_db only)
CART_MONGO_URI=mongodb://root:change_me_mongo@localhost:27017/cart_db?authSource=admin

# --- mongo-express (management UI) ---
# Host port for the mongo-express web UI
MONGO_EXPRESS_PORT=8091
# Browser login for mongo-express (basic auth)
MONGO_EXPRESS_USER=admin
# Browser password for mongo-express
MONGO_EXPRESS_PASSWORD=change_me_mongo_ui


# -----------------------------------------------------------------------------
# Redis (Cart Service cache)
# -----------------------------------------------------------------------------
# Hostname of Redis as seen by the services (localhost on host, "redis" in Docker)
REDIS_HOST=localhost
# Host port the Redis container is published on
REDIS_PORT=6379
# Redis AUTH password (requirepass)
REDIS_PASSWORD=change_me_redis

# --- redis-commander (management UI) ---
# Host port for the redis-commander web UI
REDIS_COMMANDER_PORT=8092
# Browser login for redis-commander (basic auth)
REDIS_COMMANDER_USER=admin
# Browser password for redis-commander
REDIS_COMMANDER_PASSWORD=change_me_redis_ui


# -----------------------------------------------------------------------------
# Kafka (single KRaft broker, dual listeners — domain events / saga choreography)
# -----------------------------------------------------------------------------
# KRaft cluster id: any base64 UUID (22 chars). Generate a fresh one with:
#   head -c 16 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
KAFKA_CLUSTER_ID=V7hSC1_sIRoz4mRowxKoBA
# EXTERNAL listener: port published on the host for services running on the host
KAFKA_EXTERNAL_PORT=9092
# Hostname advertised on the EXTERNAL listener (localhost, or the VM's IP/DNS name)
KAFKA_EXTERNAL_HOST=localhost
# INTERNAL listener: container-to-container traffic (reached as kafka:29092)
KAFKA_INTERNAL_PORT=29092
# KRaft controller listener port (internal to the broker only)
KAFKA_CONTROLLER_PORT=29093
# JVM heap for the broker — kept small so the stack fits on a laptop
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
# Bootstrap servers used by the application services (host now, kafka:29092 when containerised)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topic names (created explicitly in a later step; auto-creation is disabled)
KAFKA_TOPIC_ORDER_EVENTS=order-events
KAFKA_TOPIC_INVENTORY_EVENTS=inventory-events
KAFKA_TOPIC_PAYMENT_EVENTS=payment-events

# --- kafka-ui (management UI) ---
# Host port for the Kafka web UI
KAFKA_UI_PORT=8090
# Cluster label shown in the UI
KAFKA_UI_CLUSTER_NAME=orderflow


# -----------------------------------------------------------------------------
# RabbitMQ (notification task queue with retry + dead-letter)
# -----------------------------------------------------------------------------
# Host port for AMQP connections
RABBITMQ_PORT=5672
# Host port for the RabbitMQ management web UI
RABBITMQ_MANAGEMENT_PORT=15672
# Default user created on first start (also the management UI login)
RABBITMQ_USER=orderflow
# Password for RABBITMQ_USER
RABBITMQ_PASSWORD=change_me_rabbit
# Virtual host used by the application
RABBITMQ_VHOST=/
# Full AMQP URL used by the application services
RABBITMQ_URL=amqp://orderflow:change_me_rabbit@localhost:5672
# Exchange notification tasks are published to
RABBITMQ_NOTIFICATION_EXCHANGE=notifications
# Work queue the Notification Worker consumes
RABBITMQ_NOTIFICATION_QUEUE=notification.tasks
# Dead-letter exchange for exhausted tasks
RABBITMQ_NOTIFICATION_DLX=notifications.dlx
# Dead-letter queue where exhausted tasks are parked for inspection
RABBITMQ_NOTIFICATION_DLQ=notification.tasks.dlq
# How many times a failed task is retried before dead-lettering
RABBITMQ_NOTIFICATION_MAX_RETRIES=3
# Delay between retries, in milliseconds
RABBITMQ_NOTIFICATION_RETRY_DELAY_MS=5000


# -----------------------------------------------------------------------------
# Service ports & URLs (all services read this ONE file, so every port is distinct)
# -----------------------------------------------------------------------------
# API Gateway (Node) — the only port the frontend talks to
GATEWAY_PORT=4000
# Catalog Service (Node)
CATALOG_PORT=4001
# Cart Service (Node)
CART_PORT=4002
# Notification Worker (Node) — optional health endpoint
NOTIFICATION_PORT=4003
# Order Service (Spring Boot)
ORDER_PORT=8081
# Inventory Service (Spring Boot)
INVENTORY_PORT=8082
# Payment Service (Spring Boot)
PAYMENT_PORT=8083

# Upstream URLs the gateway proxies to (localhost now, container names later)
CATALOG_SERVICE_URL=http://localhost:4001
CART_SERVICE_URL=http://localhost:4002
ORDER_SERVICE_URL=http://localhost:8081
INVENTORY_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
# Comma-separated browser origins allowed by the gateway's CORS policy
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- API Gateway behaviour ---
# How long the gateway waits for a downstream service before answering 503 (ms)
GATEWAY_PROXY_TIMEOUT_MS=15000
# Rate-limit window length (ms)
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# Max requests per client IP per window (/health is exempt)
GATEWAY_RATE_LIMIT_MAX=300
# Largest accepted request body, checked against Content-Length before proxying
GATEWAY_BODY_LIMIT=1mb
# Grace period for in-flight requests on SIGTERM/SIGINT before forcing exit (ms)
GATEWAY_SHUTDOWN_TIMEOUT_MS=10000
# Express "trust proxy": false (direct), a hop count like 1 (behind nginx), or "loopback". Never "true".
GATEWAY_TRUST_PROXY=false


# -----------------------------------------------------------------------------
# Clerk (authentication — https://dashboard.clerk.com → API Keys)
# -----------------------------------------------------------------------------
# Publishable key (safe for the browser). Format is validated at gateway start-up; the placeholder will be rejected.
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
# Secret key (server-side only — the gateway uses it to verify sessions)
CLERK_SECRET_KEY=your_clerk_secret_key_here
# Optional: PEM public key for networkless JWT verification (leave empty to fetch JWKS)
CLERK_JWT_KEY=


# -----------------------------------------------------------------------------
# Razorpay (payments — https://dashboard.razorpay.com → Settings → API Keys)
# -----------------------------------------------------------------------------
# Test-mode key id
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Test-mode key secret
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Secret configured on the Razorpay webhook (used to verify webhook signatures)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# ISO currency code for orders
RAZORPAY_CURRENCY=INR

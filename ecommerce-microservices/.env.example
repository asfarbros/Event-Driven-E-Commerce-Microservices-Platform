# =============================================================================
#  OrderFlow – Environment Variables
#
#  Copy this file to `.env` (same folder) and fill in real values.
#  `.env` is git-ignored; this file is committed.
#
#  Conventions:
#   - Comments go on their own line ABOVE the variable (no inline comments —
#     this file is also read as Java .properties by the Spring services).
#   - Host-run services use localhost:* addresses. When a service is later
#     containerised, only these values change (e.g. kafka:29092, postgres:5432).
#   - Avoid `$`, `\` and quotes in values (they break Compose/dotenv parsing).
# =============================================================================


# ───────────────────────────── Infra: PostgreSQL ─────────────────────────────

# Host port mapped to the postgres container
POSTGRES_PORT=5432
# Superuser – used ONLY by the init script to create the per-service databases
POSTGRES_USER=postgres
# Superuser password
POSTGRES_PASSWORD=change-me-postgres

# Order service database name
ORDER_DB_NAME=order_db
# Order service database user (owns order_db only)
ORDER_DB_USER=order_user
# Order service database password
ORDER_DB_PASSWORD=change-me-order

# Inventory service database name
INVENTORY_DB_NAME=inventory_db
# Inventory service database user (owns inventory_db only)
INVENTORY_DB_USER=inventory_user
# Inventory service database password
INVENTORY_DB_PASSWORD=change-me-inventory

# Payment service database name
PAYMENT_DB_NAME=payment_db
# Payment service database user (owns payment_db only)
PAYMENT_DB_USER=payment_user
# Payment service database password
PAYMENT_DB_PASSWORD=change-me-payment


# ────────────────────────────── Infra: MongoDB ───────────────────────────────

# Host port mapped to the mongodb container
MONGO_PORT=27017
# Mongo root user (authSource=admin)
MONGO_ROOT_USER=mongo_admin
# Mongo root password
MONGO_ROOT_PASSWORD=change-me-mongo
# Catalog service database (created by the app on first write)
CATALOG_DB_NAME=catalog_db
# Cart service database (created by the app on first write)
CART_DB_NAME=cart_db


# ─────────────────────────────── Infra: Redis ────────────────────────────────

# Host port mapped to the redis container
REDIS_PORT=6379
# Redis AUTH password
REDIS_PASSWORD=change-me-redis


# ─────────────────────────────── Infra: Kafka ────────────────────────────────

# Host port for the EXTERNAL listener (host tools + host-run services)
KAFKA_PORT=9092
# KRaft cluster id (any valid base64 uuid; keep stable across restarts)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Bootstrap address used by services. Host: localhost:9092 · in-network: kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Domain-event topics (created explicitly in a later step)
ORDER_EVENTS_TOPIC=order-events
INVENTORY_EVENTS_TOPIC=inventory-events
PAYMENT_EVENTS_TOPIC=payment-events


# ────────────────────────────── Infra: RabbitMQ ──────────────────────────────

# Host port for AMQP
RABBITMQ_PORT=5672
# Host port for the management UI
RABBITMQ_MANAGEMENT_PORT=15672
# RabbitMQ user
RABBITMQ_USER=rabbit_user
# RabbitMQ password
RABBITMQ_PASSWORD=change-me-rabbit
# Virtual host used by OrderFlow
RABBITMQ_VHOST=orderflow
# Full AMQP URL for the notification worker (must match the four values above)
RABBITMQ_URL=amqp://rabbit_user:change-me-rabbit@localhost:5672/orderflow
# Notification task queue
NOTIFICATION_QUEUE=notifications
# Retry queue (messages wait here before being re-delivered)
NOTIFICATION_RETRY_QUEUE=notifications.retry
# Dead-letter queue (messages that exhausted all retries)
NOTIFICATION_DLQ=notifications.dlq
# How many times a notification is retried before going to the DLQ
NOTIFICATION_MAX_RETRIES=3


# ───────────────────────────── Management UIs ────────────────────────────────

# Kafka UI (topics / messages)
KAFKA_UI_PORT=8090
# Mongo Express (browse collections)
MONGO_EXPRESS_PORT=8091
# Mongo Express basic-auth user
MONGO_EXPRESS_USER=admin
# Mongo Express basic-auth password
MONGO_EXPRESS_PASSWORD=change-me-mongo-express
# Redis Commander (browse keys)
REDIS_COMMANDER_PORT=8092


# ─────────────────────────── Service: API Gateway ────────────────────────────

# Port the gateway listens on
GATEWAY_PORT=3000
# Allowed browser origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173
# Clerk publishable key (safe for browsers)
CLERK_PUBLISHABLE_KEY=pk_test_replace-me
# Clerk secret key (server-side JWT verification) – NEVER commit a real value
CLERK_SECRET_KEY=sk_test_replace-me
# Upstream service base URLs
CATALOG_SERVICE_URL=http://localhost:3001
CART_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:8080


# ──────────────────────────── Service: Catalog ───────────────────────────────

# Port the catalog service listens on
CATALOG_PORT=3001
# Mongo connection string for catalog_db (must match MONGO_* above)
CATALOG_MONGO_URI=mongodb://mongo_admin:change-me-mongo@localhost:27017/catalog_db?authSource=admin


# ────────────────────────────── Service: Cart ────────────────────────────────

# Port the cart service listens on
CART_PORT=3002
# Mongo connection string for cart_db – source of truth (must match MONGO_* above)
CART_MONGO_URI=mongodb://mongo_admin:change-me-mongo@localhost:27017/cart_db?authSource=admin
# Redis connection string – cache layer (must match REDIS_* above)
REDIS_URL=redis://:change-me-redis@localhost:6379


# ────────────────────────────── Service: Order ───────────────────────────────

# Port the order service listens on
ORDER_SERVICE_PORT=8080
# JDBC URL for order_db
ORDER_DB_URL=jdbc:postgresql://localhost:5432/order_db


# ──────────────────────────── Service: Inventory ─────────────────────────────

# Port the inventory service listens on
INVENTORY_SERVICE_PORT=8081
# JDBC URL for inventory_db
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventory_db


# ───────────────────────────── Service: Payment ──────────────────────────────

# Port the payment service listens on
PAYMENT_SERVICE_PORT=8082
# JDBC URL for payment_db
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
# Razorpay API key id (test mode)
RAZORPAY_KEY_ID=rzp_test_replace-me
# Razorpay API key secret – NEVER commit a real value
RAZORPAY_KEY_SECRET=replace-me
# Razorpay webhook signing secret – NEVER commit a real value
RAZORPAY_WEBHOOK_SECRET=replace-me


# ──────────────────────── Shared: Spring Boot / JPA ──────────────────────────

# Hibernate schema strategy: update (local dev) | validate (deployed)
JPA_DDL_AUTO=update
# Log SQL statements: true (local dev) | false (deployed)
JPA_SHOW_SQL=true


# ───────────────────────────── App: Client UI ────────────────────────────────

# Clerk publishable key exposed to the browser (same value as CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
# Gateway base URL the browser calls
VITE_API_BASE_URL=http://localhost:3000
